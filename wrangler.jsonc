{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal-qr",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".output/public"
  },
  "observability": { "enabled": true }
}
